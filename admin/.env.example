# Same database as the main app. Use a dedicated read-only role (see README).
ADMIN_DATABASE_URL="postgresql://sleevebuild_admin:CHANGE_ME@host/db?sslmode=require"
# At least 32 random characters, different from the main app's AUTH_SECRET.
ADMIN_JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
# Optional: comma-separated IPs allowed to open the panel (everyone else gets 404).
ADMIN_ALLOWED_IPS=""
