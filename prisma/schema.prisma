generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  DELETION_PENDING
  PERMANENTLY_DELETED
}

enum CardCategory {
  POKEMON
  TRAINER
  ENERGY
}

enum PhysicalStatus {
  SLEEVED
  NOT_SLEEVED
}

enum DeckImportStatus {
  IMPORTED
  PARTIALLY_RESOLVED
  READY
  INVALID
}

enum DeckTagName {
  FAVORITE
  TESTING
  ARCHIVED
}

enum Condition {
  NM
  LP
  MP
  HP
  DMG
}

enum CollectionStatus {
  COMPETITIVE
  COLLECTION
}

enum InventoryTransactionReason {
  PURCHASE
  SALE
  TRADE
  GIFT
  LOST
  DAMAGED
  CORRECTION
  OTHER
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  UNKNOWN
}

enum TurnOrder {
  FIRST
  SECOND
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  username            String        @unique
  passwordHash        String
  accountStatus       AccountStatus @default(ACTIVE)
  /// Grants access to the separate admin app. Set only directly in the database.
  isAdmin             Boolean       @default(false)
  usernameChangedAt   DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  profile               UserProfile?
  decks                 Deck[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  battleLogs            BattleLog[]
  matches               Match[]
  tournaments           Tournament[]
  hostedTournaments     HostedTournament[]
  hostedEntries         HostedTournamentEntry[]
  auditLogs             AuditLog[]
  sessions              UserSession[]

  @@index([username])
  @@index([accountStatus])
  @@map("users")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model CardSet {
  id          String    @id @default(cuid())
  tcgdexId    String    @unique
  name        String
  code        String?
  series      String?
  releaseDate DateTime?
  logoUrl     String?
  symbolUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Manual Standard legality set in the admin panel (null = automatic).
  /// Applied to the printings' `legalStandard` by the panel and by the sync.
  standardOverride     Boolean?
  standardOverrideById String?
  standardOverrideAt   DateTime?

  printings CardPrinting[]

  @@index([code])
  @@index([name])
  @@map("card_sets")
}

model CardLogical {
  id            String       @id @default(cuid())
  canonicalName String
  category      CardCategory
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  printings CardPrinting[]
  deckCards DeckCard[]

  @@unique([canonicalName, category])
  @@index([canonicalName])
  @@index([category])
  @@map("card_logicals")
}

model CardPrinting {
  id                String       @id @default(cuid())
  tcgdexId          String       @unique
  logicalCardId     String
  setId             String
  localId           String
  name              String
  category          CardCategory
  rarity            String?
  illustrator       String?
  regulationMark    String?
  /// Effective Standard legality: the set's manual override, else legalStandardAuto.
  legalStandard     Boolean      @default(false)
  /// Standard legality from TCGdex (plus the new-set inference), written by the sync.
  legalStandardAuto Boolean      @default(false)
  legalExpanded     Boolean      @default(false)
  imageUrl          String?
  tcgdexUpdatedAt   DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  logicalCard    CardLogical     @relation(fields: [logicalCardId], references: [id], onDelete: Restrict)
  set            CardSet         @relation(fields: [setId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]
  deckCovers     Deck[]          @relation("DeckCover")

  @@unique([setId, localId])
  @@index([tcgdexId])
  @@index([setId])
  @@index([localId])
  @@index([logicalCardId])
  @@index([name])
  @@index([category])
  @@index([regulationMark])
  @@index([legalStandard])
  @@index([legalExpanded])
  @@map("card_printings")
}

model Format {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules             FormatRule[]
  decks             Deck[]
  matches           Match[]
  tournaments       Tournament[]
  hostedTournaments HostedTournament[]

  @@map("formats")
}

model FormatRule {
  id        String   @id @default(cuid())
  formatId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  format Format @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@unique([formatId, key])
  @@index([formatId])
  @@map("format_rules")
}

model Archetype {
  id             String   @id @default(cuid())
  name           String   @unique
  displayPokemon Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  decks           Deck[]
  opponentMatches Match[] @relation("OpponentArchetype")

  @@index([name])
  @@map("archetypes")
}

model Deck {
  id              String            @id @default(cuid())
  userId          String
  name            String
  formatId        String
  archetypeId     String?
  description     String?
  physicalStatus  PhysicalStatus    @default(NOT_SLEEVED)
  importStatus    DeckImportStatus?
  /// Carta escolhida para representar o deck na lista (recorte da arte).
  coverPrintingId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverPrinting CardPrinting?           @relation("DeckCover", fields: [coverPrintingId], references: [id], onDelete: SetNull)
  format        Format                  @relation(fields: [formatId], references: [id], onDelete: Restrict)
  archetype     Archetype?              @relation(fields: [archetypeId], references: [id], onDelete: SetNull)
  cards         DeckCard[]
  tags          DeckTag[]
  allocations   DeckAllocation[]
  matches       Match[]
  hostedEntries HostedTournamentEntry[]

  @@index([userId])
  @@index([formatId])
  @@index([archetypeId])
  @@index([physicalStatus])
  @@map("decks")
}

model DeckCard {
  id            String @id @default(cuid())
  deckId        String
  logicalCardId String
  quantity      Int

  deck        Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  logicalCard CardLogical @relation(fields: [logicalCardId], references: [id], onDelete: Restrict)

  @@unique([deckId, logicalCardId])
  @@index([deckId])
  @@index([logicalCardId])
  @@map("deck_cards")
}

model DeckTag {
  id     String      @id @default(cuid())
  deckId String
  tag    DeckTagName

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, tag])
  @@index([deckId])
  @@map("deck_tags")
}

model InventoryItem {
  id               String           @id @default(cuid())
  userId           String
  cardPrintingId   String
  quantity         Int
  condition        Condition        @default(NM)
  language         String           @default("en")
  collectionStatus CollectionStatus @default(COMPETITIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardPrinting CardPrinting           @relation(fields: [cardPrintingId], references: [id], onDelete: Restrict)
  allocations  DeckAllocation[]
  transactions InventoryTransaction[]

  @@unique([userId, cardPrintingId, condition, language, collectionStatus])
  @@index([userId])
  @@index([cardPrintingId])
  @@index([collectionStatus])
  @@map("inventory_items")
}

model DeckAllocation {
  id              String   @id @default(cuid())
  deckId          String
  inventoryItemId String
  quantity        Int
  createdAt       DateTime @default(now())

  deck          Deck          @relation(fields: [deckId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([deckId, inventoryItemId])
  @@index([deckId])
  @@index([inventoryItemId])
  @@map("deck_allocations")
}

model InventoryTransaction {
  id              String                     @id @default(cuid())
  userId          String
  inventoryItemId String
  quantityDelta   Int
  reason          InventoryTransactionReason
  note            String?
  createdAt       DateTime                   @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model BattleLog {
  id            String   @id @default(cuid())
  userId        String
  rawLog        String
  source        String
  importedAt    DateTime @default(now())
  parserVersion String

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match?

  @@index([userId])
  @@index([importedAt])
  @@map("battle_logs")
}

model Match {
  id                  String      @id @default(cuid())
  userId              String
  battleLogId         String?     @unique
  deckId              String
  opponentArchetypeId String?
  result              MatchResult
  turnOrder           TurnOrder?
  gameFormatCode      String?
  formatId            String?
  notes               String?
  playedAt            DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleLog         BattleLog?       @relation(fields: [battleLogId], references: [id], onDelete: SetNull)
  deck              Deck             @relation(fields: [deckId], references: [id], onDelete: Restrict)
  opponentArchetype Archetype?       @relation("OpponentArchetype", fields: [opponentArchetypeId], references: [id], onDelete: SetNull)
  format            Format?          @relation(fields: [formatId], references: [id], onDelete: SetNull)
  tournamentMatch   TournamentMatch?

  @@index([userId])
  @@index([deckId])
  @@index([opponentArchetypeId])
  @@index([formatId])
  @@index([playedAt])
  @@index([result])
  @@map("matches")
}

model Tournament {
  id               String    @id @default(cuid())
  userId           String
  name             String
  date             DateTime?
  location         String?
  formatId         String?
  placement        Int?
  participantCount Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  format            Format?           @relation(fields: [formatId], references: [id], onDelete: SetNull)
  tournamentMatches TournamentMatch[]

  @@index([userId])
  @@index([formatId])
  @@index([date])
  @@map("tournaments")
}

model TournamentMatch {
  id           String @id @default(cuid())
  tournamentId String
  matchId      String @unique
  round        Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match      Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, matchId])
  @@index([tournamentId])
  @@map("tournament_matches")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Login session. The refresh token lives in an httpOnly cookie and only its
/// SHA-256 hash is stored, so a database leak doesn't expose usable tokens.
/// Revoking a session (logout) stops new access tokens from being issued.
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  rememberMe       Boolean   @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Fixed-window rate limit counters shared by every server instance.
model AuthRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
  @@map("auth_rate_limits")
}

// ---------------------------------------------------------------------------
// Hosted (organized) tournaments: Swiss rounds run on the platform.
// ---------------------------------------------------------------------------

enum HostedTournamentStatus {
  REGISTRATION
  IN_PROGRESS
  FINISHED
}

enum HostedLocationType {
  IN_PERSON
  ONLINE
}

enum HostedDeckPolicy {
  /// Every player must register a platform deck of the tournament format.
  REQUIRED
  /// A deck is optional ("open list").
  OPTIONAL
}

enum HostedEntryStatus {
  ACTIVE
  DROPPED
}

enum HostedRoundStatus {
  IN_PROGRESS
  FINISHED
}

enum HostedPairingStatus {
  /// No result reported yet.
  PENDING
  /// One player reported; waiting for the opponent.
  AWAITING_CONFIRMATION
  /// Final result (confirmed by both, set by the judge, or a timer draw).
  CONFIRMED
  /// Players disagree, or the timer ran out before the confirmation.
  DISPUTED
  /// Player 1 has no opponent this round.
  BYE
}

enum HostedPairingResult {
  PLAYER1_WIN
  PLAYER2_WIN
  DRAW
}

enum HostedResultSource {
  PLAYERS
  TIMER
  JUDGE
  BYE
}

model HostedTournament {
  id            String                 @id @default(cuid())
  /// Unguessable code used in the share link (/t/<code>).
  code          String                 @unique
  organizerId   String
  name          String
  date          DateTime?
  locationType  HostedLocationType
  location      String?
  formatId      String
  bestOf        Int
  pointsWin     Int                    @default(3)
  pointsDraw    Int                    @default(1)
  pointsLoss    Int                    @default(0)
  deckPolicy    HostedDeckPolicy
  /// Null = suggested from the player count when the tournament starts.
  plannedRounds Int?
  roundMinutes  Int
  maxPlayers    Int?
  status        HostedTournamentStatus @default(REGISTRATION)
  currentRound  Int                    @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  organizer User                    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  format    Format                  @relation(fields: [formatId], references: [id], onDelete: Restrict)
  entries   HostedTournamentEntry[]
  rounds    HostedTournamentRound[]

  @@index([organizerId])
  @@index([status])
  @@map("hosted_tournaments")
}

model HostedTournamentEntry {
  id                String            @id @default(cuid())
  tournamentId      String
  userId            String
  /// Live link to the player's deck; only used until the tournament starts.
  deckId            String?
  status            HostedEntryStatus @default(ACTIVE)
  /// Last round the player was paired in before dropping (0 = before round 1).
  droppedAfterRound Int?
  joinedAt          DateTime          @default(now())

  tournament   HostedTournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck         Deck?               @relation(fields: [deckId], references: [id], onDelete: SetNull)
  snapshot     HostedDeckSnapshot?
  pairingsAsP1 HostedPairing[]     @relation("HostedPairingPlayer1")
  pairingsAsP2 HostedPairing[]     @relation("HostedPairingPlayer2")

  @@unique([tournamentId, userId])
  @@index([userId])
  @@index([deckId])
  @@map("hosted_tournament_entries")
}

/// Frozen copy of a player's list, taken when the tournament starts. It is
/// independent from the original deck, which the player may keep editing.
model HostedDeckSnapshot {
  id             String   @id @default(cuid())
  entryId        String   @unique
  deckName       String
  archetypeId    String?
  archetypeName  String?
  displayPokemon Json?
  coverImageUrl  String?
  /// [{ logicalCardId, name, category, quantity, imageUrl }]
  cards          Json
  cardCount      Int
  createdAt      DateTime @default(now())

  entry HostedTournamentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@map("hosted_deck_snapshots")
}

model HostedTournamentRound {
  id               String            @id @default(cuid())
  tournamentId     String
  number           Int
  status           HostedRoundStatus @default(IN_PROGRESS)
  durationSeconds  Int
  startedAt        DateTime
  /// Set while the timer is paused.
  pausedAt         DateTime?
  /// Total paused time already accumulated (seconds).
  pausedSeconds    Int               @default(0)
  /// When the time-out rules (auto draws / disputes) were applied.
  timeoutAppliedAt DateTime?
  finishedAt       DateTime?

  tournament HostedTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  pairings   HostedPairing[]

  @@unique([tournamentId, number])
  @@map("hosted_tournament_rounds")
}

model HostedPairing {
  id                String               @id @default(cuid())
  roundId           String
  /// 1..n/2; null for a bye.
  tableNumber       Int?
  player1Id         String
  player2Id         String?
  status            HostedPairingStatus  @default(PENDING)
  result            HostedPairingResult?
  player1Games      Int                  @default(0)
  player2Games      Int                  @default(0)
  drawGames         Int                  @default(0)
  source            HostedResultSource?
  reportedByEntryId String?
  reportedAt        DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  round   HostedTournamentRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player1 HostedTournamentEntry  @relation("HostedPairingPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 HostedTournamentEntry? @relation("HostedPairingPlayer2", fields: [player2Id], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([player1Id])
  @@index([player2Id])
  @@map("hosted_pairings")
}
