# Copie para .env e preencha os valores locais. Nunca versione secrets reais.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sleevebuild?schema=public"

# Segredo para assinar sessões (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-valor-aleatorio"

# TCGdex
TCGDEX_API_BASE_URL="https://api.tcgdex.net/v2"
TCGDEX_LANGUAGE="en"
TCGDEX_SYNC_CONCURRENCY="4"

# URL pública da app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
